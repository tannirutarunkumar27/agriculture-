  "refit_rounds": "median_best_round_across_seven_inner_folds_at_selected_configuration",
  "outer_inference": false,
  "privacy_enabled": false,
  "previous_exposure": "All baseline and simulation outcomes previously exposed; no independent confirmation"
}
