# visualize_dataset_preview_pdf.ipynb
# AgriField-Manipur Dataset Visualization + PDF Export with Preview

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os
from fpdf import FPDF

# -----------------------------
# 1. Load Dataset
# -----------------------------
data_path = "../data/final_dataset.csv"  # adjust path if needed
df = pd.read_csv(data_path, parse_dates=['date'])

# -----------------------------
# 2. Create output folders
# -----------------------------
output_dir = "../documentation/charts"
pdf_file = "../documentation/AgriField_Charts.pdf"
os.makedirs(output_dir, exist_ok=True)

# -----------------------------
# 3. Chart generator function
# -----------------------------
chart_files = []

def generate_charts(preview=True):
    # Temperature Trend
    fig = plt.figure(figsize=(10,5))
    sns.lineplot(data=df, x='date', y='temperature', hue='district', marker='o')
    plt.title("Temperature Trend by District")
    plt.xlabel("Date")
    plt.ylabel("Temperature (°C)")
    plt.xticks(rotation=45)
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/temperature_trend.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

    # Humidity Trend
    fig = plt.figure(figsize=(10,5))
    sns.lineplot(data=df, x='date', y='humidity', hue='district', marker='o')
    plt.title("Humidity Trend by District")
    plt.xlabel("Date")
    plt.ylabel("Humidity (%)")
    plt.xticks(rotation=45)
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/humidity_trend.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

    # Soil Moisture Distribution
    fig = plt.figure(figsize=(8,5))
    sns.boxplot(data=df, x='district', y='soil_moisture')
    plt.title("Soil Moisture Distribution by District")
    plt.xlabel("District")
    plt.ylabel("Soil Moisture (%)")
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/soil_moisture_distribution.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

    # pH Distribution
    fig = plt.figure(figsize=(8,5))
    sns.histplot(df['ph'], bins=20, kde=True, color='green')
    plt.title("Soil pH Distribution")
    plt.xlabel("pH Value")
    plt.ylabel("Frequency")
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/ph_distribution.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

    # Rainfall Trend
    fig = plt.figure(figsize=(10,5))
    sns.lineplot(data=df, x='date', y='rainfall', hue='district', marker='o')
    plt.title("Rainfall Trend by District")
    plt.xlabel("Date")
    plt.ylabel("Rainfall (mm)")
    plt.xticks(rotation=45)
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/rainfall_trend.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

    # Correlation Heatmap
    fig = plt.figure(figsize=(8,6))
    corr = df[['temperature', 'humidity', 'soil_moisture', 'ph', 'rainfall']].corr()
    sns.heatmap(corr, annot=True, cmap='coolwarm', fmt=".2f")
    plt.title("Correlation Heatmap")
    plt.tight_layout()
    if preview: plt.show()
    file_path = f"{output_dir}/correlation_heatmap.png"
    fig.savefig(file_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    chart_files.append(file_path)

# -----------------------------
# 4. Run chart generation with preview
# -----------------------------
generate_charts(preview=True)

# -----------------------------
# 5. Combine all charts into PDF
# -----------------------------
pdf = FPDF(orientation='P', unit='mm', format='A4')
for chart in chart_files:
    pdf.add_page()
    pdf.image(chart, x=10, y=20, w=190)  # fit A4 width

pdf.output(pdf_file)
print(f"All charts saved as images in {output_dir}")
print(f"Combined PDF saved as {pdf_file}")
